# Apify — Instagram data collection (server-side only, never exposed to the browser)
APIFY_TOKEN=
APIFY_ACTOR_ID=

# AI sales analysis (server-side only) — pick a provider
# AI_PROVIDER=anthropic (default) | openrouter
AI_PROVIDER=anthropic

# Anthropic
X9_ANTHROPIC_API_KEY=
# Optional override, defaults to "claude-sonnet-5" if not set
ANTHROPIC_MODEL=claude-sonnet-5

# OpenRouter (used when AI_PROVIDER=openrouter)
X9_OPENROUTER_API_KEY=
# Optional override, defaults to "minimax/minimax-m3:free" if not set
OPENROUTER_MODEL=minimax/minimax-m3:free
